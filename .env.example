# JARVIS environment — copy this file, rename the copy to exactly ".env"
# Key from: https://aistudio.google.com/apikey
# RULES: never share this key, never paste it into chat, never ship it in an APK.

# Without a key the server runs REHEARSAL mode (local understudy, real tools).
# With a key it runs REAL mode: Gemini Live voice + tools.
GEMINI_API_KEY=AQ.Ab8RN6IPDBJ8BIZGvZNJJvggqUfSjDYyl3iXg0HKHb5-QoX1JQ

# REQUIRED before exposing Jarvis beyond your own machine (cloud/phone).
# Any long random string. The HUD will ask for it once and remember it.
# Without it the server runs in local dev mode and prints a warning.
JARVIS_ACCESS_TOKEN=
